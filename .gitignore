# Godot 4
.godot/
*.translation

# Import cache (not sidecar *.import files next to assets)
.import/

# Runtime evidence is versioned as source PNGs; editor-generated imports are not.
artifacts/**/*.import

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# Logs / temp
*.log
*.tmp
*.temp
*.bak

# Secrets / local env
.env
.env.*
*.env
credentials.json
secrets.json
*.pem
*.key
api_keys.*

# Reproducible extraction / work dirs
_asset_work/
**/temp_extract/
**/temp_capture/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Do NOT ignore:
# assets/          — production assets required for the game
# artifacts/live/  — live runtime captures
# artifacts/m*/    — milestone screenshots
# docs/            — documentation
